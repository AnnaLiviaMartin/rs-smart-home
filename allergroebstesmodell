/-
  Smart Home – Allergröbstes Modell

  Modelliert werden nur:
  - Räume
  - Nachbarschaft
  - Symmetrie
  - Keine Selbstnachbarschaft
-/

universe u

/-- Die Menge aller Räume. -/
constant Raum : Type u

namespace SmartHome

/-- Nachbarschaftsrelation zwischen Räumen. -/
constant Nachbar : Raum → Raum → Prop

/--
Ein Raum ist niemals sein eigener Nachbar.
-/
axiom keineSelbstNachbarschaft :
  ∀ r : Raum, ¬ Nachbar r r

/--
Nachbarschaft ist symmetrisch.
-/
axiom symmetrie :
  ∀ {r₁ r₂ : Raum},
    Nachbar r₁ r₂ →
    Nachbar r₂ r₁

end SmartHome