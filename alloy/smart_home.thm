<?xml version="1.0"?>
<alloy>

<view>

<defaultnode/>

<defaultedge/>

<node>
   <type name="AUTHENTICATION"/>
   <type name="GARTEN"/>
   <type name="Int"/>
   <type name="PERSON"/>
   <type name="RAUM"/>
   <type name="String"/>
   <type name="TUER"/>
   <type name="univ"/>
   <type name="ZIMMER"/>
   <type name="seq/Int"/>
</node>

<edge style="inherit" visible="no" attribute="yes">
   <relation name="personenImRaum"> <type name="RAUM"/> <type name="PERSON"/> </relation>
</edge>

<edge visible="no" attribute="yes">
   <relation name="authentication"> <type name="ZIMMER"/> <type name="AUTHENTICATION"/> </relation>
   <relation name="authentifiziertePersonen"> <type name="AUTHENTICATION"/> <type name="PERSON"/> </relation>
   <relation name="id"> <type name="RAUM"/> <type name="Int"/> </relation>
</edge>

</view>

</alloy>
